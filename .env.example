# ============================================
# Frido Master Dashboard — Environment Variables
# ============================================
# Copy this file to `.env` for local development.

# ── Clerk (required) ────────────────────────────────────
# Dashboard & API auth. Keys from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# API server port (local). Render sets PORT automatically.
API_PORT=4000

# Public URL of the app (invite links, email CTAs). Match how users open the site.
FRONTEND_URL=http://localhost:4000
APP_URL=http://localhost:4000

# ── Database ───────────────────────────────────────────
# Leave DATABASE_URL empty for local SQLite.
DATABASE_URL=
SQLITE_DB_PATH=

# ── Default admin seed (first deploy / local) ───────────
# If this email has no Clerk user yet, the server creates one and syncs SQLite.
# Use a strong secret; never commit `.env` with real passwords.
DEFAULT_ADMIN_EMAIL=ritwik.m@myfrido.com
DEFAULT_ADMIN_PASSWORD=

# ── Invites & email ────────────────────────────────────
ALLOWED_EMAIL_DOMAINS=myfrido.com

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_INVITE_SENDER=yourstruly@myfrido.com

# Branding (optional for transactional email)
# EMAIL_HEADER_LOGO_PATH=
# EMAIL_FOOTER_LOGO_PATH=
# EMAIL_HEADER_LOGO_URL=
# BRAND_FOOTER_LOGO_URL=
# SUPPORT_CONTACT=support@myfrido.com

# Static demo mode (GitHub Pages only)
# VITE_DEMO_MODE=false
