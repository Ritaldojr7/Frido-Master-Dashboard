# =============================================================================
# Frido Master Dashboard — Environment Variables
# Copy this file to `.env` and fill in values. Never commit `.env` to git.
# =============================================================================

# --- Core (required in production) -------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3005
# Extra browser origins permitted to call the API (comma-separated). APP_URL and
# FRONTEND_URL are always included; localhost is added automatically outside production.
# Leave empty unless another front end needs cross-origin access.
CORS_ALLOWED_ORIGINS=
NODE_ENV=development
PORT=4000

# --- Auth & access control ---------------------------------------------------
ALLOWED_EMAIL_DOMAINS=myfrido.com
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
ACCESS_REQUEST_NOTIFY_EMAIL=
DB_PING_SECRET=
DB_CLIENT=

# NEVER set VITE_DEMO_MODE=true in production (Render, CI build, or npm start).
# Demo mode bypasses Clerk auth for local UI work and static GitHub Pages builds only.
VITE_DEMO_MODE=false
VITE_DEMO_ROLE=staff
VITE_DEMO_USER_EMAIL=demo@myfrido.com
VITE_DEMO_USER_NAME=Demo User

# --- Static dashboard access control (SERVER-SIDE — authoritative) -----------
# These gate /salary-analysis, /exec-dashboard and /fes-sm-dashboard in
# server/middleware/protectStaticDashboards.js. The VITE_ variants below are inlined into
# the client bundle and readable by any user, so they must never be the only control.
# When unset, the server falls back to the VITE_ variant for backward compatibility —
# set these in Render and the fallback stops mattering.
# Empty SALARY_ANALYSIS_EMAILS  ⇒ admins only.
# Empty ISD_DASHBOARD_EMAILS    ⇒ admin / data_analyst.
# Empty STORE_EMAIL_MAP         ⇒ admin / staff.
SALARY_ANALYSIS_EMAILS=
ISD_DASHBOARD_EMAILS=
STORE_EMAIL_MAP={}

# --- Organization config (comma-separated / JSON — no secrets) ---------------
# NOTE: these are build-time client values used for UI affordances only (hiding links,
# picking a home page). They are NOT access control — see the server-side block above.
# Emails allowed to open ISD executive dashboards
VITE_ISD_DASHBOARD_EMAILS=
# Emails allowed to open salary analysis
VITE_SALARY_ANALYSIS_EMAILS=
# Store manager email → display name map (JSON object)
VITE_STORE_EMAIL_MAP={}
# Per-user home page overrides (JSON object: email → path)
VITE_HOME_PATH_BY_EMAIL={}
# Login page "Contact Admin" mailto target
VITE_SUPPORT_CONTACT_EMAIL=support@myfrido.com
# Retail staff escalation contacts (JSON array of {name,pocFor,email,phone})
VITE_STAFF_ESCALATION_CONTACTS=[]
# Retail leadership contacts (JSON array of {name,pocFor,email,phone})
VITE_RETAIL_STRUCTURE_CONTACTS=[]

# --- Email (Microsoft Graph) -------------------------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_INVITE_SENDER=
NOTICES_EMAIL_DISABLED=false
NOTICES_EMAIL_TIMEZONE=Asia/Kolkata
EMAIL_HEADER_LOGO_URL=
EMAIL_HEADER_LOGO_PATH=
EMAIL_FOOTER_LOGO_PATH=
BRAND_FOOTER_LOGO_URL=
SUPPORT_CONTACT=support@myfrido.com

# --- Supabase Storage --------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_NOTICE_BUCKET=
SUPABASE_HR_POLICY_BUCKET=

# --- Google Sheets (shared service account) ----------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Order Dispute sync ------------------------------------------------------
ORDER_DISPUTE_SPREADSHEET_ID=
ORDER_DISPUTE_SHEET_GID_1=1178023285
ORDER_DISPUTE_SHEET_GID_2=
ORDER_DISPUTE_SYNC_MS=60000
ORDER_DISPUTE_SYNC_SECRET=

# --- Manpower sync -----------------------------------------------------------
MANPOWER_SPREADSHEET_ID=
MANPOWER_SYNC_MS=300000
MANPOWER_SYNC_SECRET=

# --- Dashboard edit (GitHub dispatch) ----------------------------------------
# /api/exec-edit-trigger requires an authenticated admin (Clerk session or Bearer).
# IST_EDIT_PASS / EXEC_EDIT_PASS are REMOVED — the shared-password path was an
# unauthenticated route to a GitHub workflow dispatch. Delete them from Render.
GH_REPO=
GH_TOKEN=

# --- Database (local dev) ----------------------------------------------------
SQLITE_DB_PATH=
# PGSSLMODE=disable turns TLS off entirely (local Postgres only).
PGSSLMODE=
# Verify the database certificate. Set PGSSL_VERIFY=true to trust Node's bundled CA
# store (sufficient for Supabase), or PGSSLROOTCERT to an explicit CA — inline PEM or a
# file path. With neither set the connection is encrypted but NOT authenticated, which
# leaves it open to an active MITM. Set one of these in production.
PGSSL_VERIFY=
PGSSLROOTCERT=

# --- Build / deploy (optional) -----------------------------------------------
GITHUB_PAGES=false
REPO_NAME=Frido-Master-Dashboard
VITE_APP_TYPE=
API_PORT=4000
