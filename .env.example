# =============================================================================
# Frido Master Dashboard — Environment Variables
# Copy this file to `.env` and fill in values. Never commit `.env` to git.
# =============================================================================

# --- Core (required in production) -------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3005
NODE_ENV=development
PORT=4000

# --- Auth & access control ---------------------------------------------------
ALLOWED_EMAIL_DOMAINS=myfrido.com
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
ACCESS_REQUEST_NOTIFY_EMAIL=
DB_PING_SECRET=
DB_CLIENT=

# NEVER set VITE_DEMO_MODE=true in production (Render, CI build, or npm start).
# Demo mode bypasses Clerk auth for local UI work and static GitHub Pages builds only.
VITE_DEMO_MODE=false
VITE_DEMO_ROLE=staff
VITE_DEMO_USER_EMAIL=demo@myfrido.com
VITE_DEMO_USER_NAME=Demo User

# --- Organization config (comma-separated / JSON — no secrets) ---------------
# Emails allowed to open ISD executive dashboards
VITE_ISD_DASHBOARD_EMAILS=
# Emails allowed to open salary analysis
VITE_SALARY_ANALYSIS_EMAILS=
# Store manager email → display name map (JSON object)
VITE_STORE_EMAIL_MAP={}
# Per-user home page overrides (JSON object: email → path)
VITE_HOME_PATH_BY_EMAIL={}
# Login page "Contact Admin" mailto target
VITE_SUPPORT_CONTACT_EMAIL=support@myfrido.com
# Retail staff escalation contacts (JSON array of {name,pocFor,email,phone})
VITE_STAFF_ESCALATION_CONTACTS=[]
# Retail leadership contacts (JSON array of {name,pocFor,email,phone})
VITE_RETAIL_STRUCTURE_CONTACTS=[]

# --- Email (Microsoft Graph) -------------------------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_INVITE_SENDER=
NOTICES_EMAIL_DISABLED=false
NOTICES_EMAIL_TIMEZONE=Asia/Kolkata
EMAIL_HEADER_LOGO_URL=
EMAIL_HEADER_LOGO_PATH=
EMAIL_FOOTER_LOGO_PATH=
BRAND_FOOTER_LOGO_URL=
SUPPORT_CONTACT=support@myfrido.com

# --- Supabase Storage --------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_NOTICE_BUCKET=
SUPABASE_HR_POLICY_BUCKET=

# --- Google Sheets (shared service account) ----------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Order Dispute sync ------------------------------------------------------
ORDER_DISPUTE_SPREADSHEET_ID=
ORDER_DISPUTE_SHEET_GID_1=1178023285
ORDER_DISPUTE_SHEET_GID_2=
ORDER_DISPUTE_SYNC_MS=60000
ORDER_DISPUTE_SYNC_SECRET=

# --- Manpower sync -----------------------------------------------------------
MANPOWER_SPREADSHEET_ID=
MANPOWER_SYNC_MS=300000
MANPOWER_SYNC_SECRET=

# --- Dashboard edit (GitHub dispatch) ----------------------------------------
GH_REPO=
GH_TOKEN=
IST_EDIT_PASS=
EXEC_EDIT_PASS=

# --- Database (local dev) ----------------------------------------------------
SQLITE_DB_PATH=
PGSSLMODE=

# --- Build / deploy (optional) -----------------------------------------------
GITHUB_PAGES=false
REPO_NAME=Frido-Master-Dashboard
VITE_APP_TYPE=
API_PORT=4000
