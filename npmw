#!/usr/bin/env bash
# Run npm using the bundled Node.js runtime (no global Node/npm required).
ROOT="$(cd "$(dirname "$0")" && pwd)"
NODE_BIN="$ROOT/.tools/node-v22.16.0-darwin-arm64/bin"
if [[ ! -x "$NODE_BIN/npm" ]]; then
  echo "Bundled Node.js not found. Downloading..."
  mkdir -p "$ROOT/.tools"
  curl -fsSL "https://nodejs.org/dist/v22.16.0/node-v22.16.0-darwin-arm64.tar.gz" -o "$ROOT/.tools/node.tar.gz"
  tar -xzf "$ROOT/.tools/node.tar.gz" -C "$ROOT/.tools"
  rm "$ROOT/.tools/node.tar.gz"
fi
export PATH="$NODE_BIN:$PATH"
exec npm "$@"
