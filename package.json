{
  "name": "frido-master-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staff": "vite --mode staff",
    "dev:server": "node server/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "ngrok": "ngrok http --domain=windrode-porfirio-pseudolegal.ngrok-free.dev 3000",
    "start": "node server/index.js",
    "build": "vite build",
    "build:staff": "vite build --mode staff",
    "deploy:staff": "npm run build:staff && npx gh-pages -d dist",
    "migrate:supabase": "node server/scripts/migrateSqliteToSupabase.js",
    "seed:dashboard-links": "node server/scripts/seedDashboardLinks.js",
    "seed:feedback-products": "node server/scripts/seedFeedbackProducts.js",
    "seed:supabase-all": "node server/scripts/seedSupabaseAll.js",
    "upload:hr-policy-pdfs": "node server/scripts/uploadHrPolicyPdfs.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@clerk/express": "^2.1.9",
    "@clerk/react": "^6.4.5",
    "@supabase/supabase-js": "^2.49.1",
    "better-sqlite3": "^12.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "googleapis": "^144.0.0",
    "multer": "^2.0.0",
    "papaparse": "^5.5.3",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18"
  }
}
